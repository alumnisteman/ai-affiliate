# Copy this file to .env.production and replace every CHANGE_ME value.
# Keep this file private. Do not commit .env.production.

POSTGRES_DB=ai_affiliate_os
POSTGRES_USER=ai_affiliate
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
DATABASE_URL=postgresql://ai_affiliate:CHANGE_ME_USE_A_LONG_RANDOM_VALUE@postgres:5432/ai_affiliate_os

REDIS_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
REDIS_URL=redis://:CHANGE_ME_USE_A_LONG_RANDOM_VALUE@redis:6379

RABBITMQ_DEFAULT_USER=ai_affiliate
RABBITMQ_DEFAULT_PASS=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
RABBITMQ_URL=amqp://ai_affiliate:CHANGE_ME_USE_A_LONG_RANDOM_VALUE@rabbitmq:5672

MEILI_MASTER_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VALUE_AT_LEAST_16_CHARS
MEILI_URL=http://meilisearch:7700

SESSION_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
NODE_ENV=production
API_PORT=8080

# Public domains used by nginx/SSL instructions.
APP_DOMAIN=app.aiaffiliateos.com
API_DOMAIN=api.aiaffiliateos.com

# ── Affiliate Intelligence Platform Env Vars ──

# AI Provider (Anthropic)
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
AI_MODEL=claude-3-5-sonnet-20241022

# Telegram Notification (For Viral Alerts & Coach)
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_ALERT_CHAT_ID=CHANGE_ME_TELEGRAM_CHAT_ID

# Shortlink & Server
SERVER_IP=192.168.1.13

# Marketplace Escrow (Stripe)
STRIPE_SECRET_KEY=CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET

# GDPR Compliance Flag
GDPR_COMPLIANCE=true